<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>

      <!-- Basic Latin: space through tilde (standard ASCII) -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>

      <!-- Latin Extended-A: Ā–ſ (U+0100–U+017F)
           Covers most Western and Central European languages -->
      <CharacterRegion>
        <Start>&#256;</Start>
        <End>&#383;</End>
      </CharacterRegion>

      <!-- Latin Extended-B: partial (U+0180–U+024F)
           Covers remaining common European and transliteration characters -->
      <CharacterRegion>
        <Start>&#384;</Start>
        <End>&#591;</End>
      </CharacterRegion>

      <!-- General Punctuation: U+2000–U+206F
           Includes em dash (–—), ellipsis (…), curly quotes (""), en dash, etc. -->
      <CharacterRegion>
        <Start>&#8192;</Start>
        <End>&#8303;</End>
      </CharacterRegion>

      <!-- Currency Symbols: U+20A0–U+20CF
           Credits symbol ₢, Euro €, etc. -->
      <CharacterRegion>
        <Start>&#8352;</Start>
        <End>&#8399;</End>
      </CharacterRegion>

    </CharacterRegions>
  </Asset>
</XnaContent>
